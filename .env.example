# 复制为 .env（Docker / 本地都读它）。不要提交真实密钥。
TZ=Asia/Shanghai

# ---- 通知 ----
TG_BOT_TOKEN=
TG_CHAT_ID=
TG_THREAD_ID=
# WECOM_WEBHOOK=

# ---- NodeSeek ----
# F12 -> Network -> 刷新 -> 任选一条 nodeseek 请求 -> Request Headers -> 复制整条 Cookie
# 多账号用 | 分隔
NS_COOKIE=
NS_MODE=random          # random | fixed
NS_STRATEGY=auto         # auto | api | browser

# ---- V2EX ----
# 只需要 A2 那一段：A2=xxxx%3D%3D
V2EX_COOKIE=

# ---- 烧饼社区 linux.sb ----
LINUXSB_COOKIE=
# Cookie 失效时的自动登录兜底（可选）
LINUXSB_USERNAME=
LINUXSB_PASSWORD=

# ---- 烧饼论坛 sb.sb ----
# F12 复制整条 Cookie（登录后访问 https://sb.sb/signin/ 时抓取请求头）
SBSB_COOKIE=
SBSB_USERNAME=
SBSB_PASSWORD=

# ---- 运行参数（可选）----
# PROXY=http://127.0.0.1:7890
# BROWSER_BACKEND=auto     # auto | camoufox | playwright | none
# HEADLESS=true
# RETRIES=1
# LOG_LEVEL=INFO
